<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/wristBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:text="WristChat"
        android:textColor="?attr/wristText"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:letterSpacing="0.4"
        android:text="○○○○"
        android:textColor="?attr/wristText"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="请输入密码"
        android:textColor="?attr/wristHint"
        android:textSize="13sp" />

    <GridLayout
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:columnCount="3">

        <Button
            android:id="@+id/btn1"
            style="@style/LockKey"
            android:text="1" />
        <Button
            android:id="@+id/btn2"
            style="@style/LockKey"
            android:text="2" />
        <Button
            android:id="@+id/btn3"
            style="@style/LockKey"
            android:text="3" />
        <Button
            android:id="@+id/btn4"
            style="@style/LockKey"
            android:text="4" />
        <Button
            android:id="@+id/btn5"
            style="@style/LockKey"
            android:text="5" />
        <Button
            android:id="@+id/btn6"
            style="@style/LockKey"
            android:text="6" />
        <Button
            android:id="@+id/btn7"
            style="@style/LockKey"
            android:text="7" />
        <Button
            android:id="@+id/btn8"
            style="@style/LockKey"
            android:text="8" />
        <Button
            android:id="@+id/btn9"
            style="@style/LockKey"
            android:text="9" />
        <View
            android:layout_width="72dp"
            android:layout_height="0dp" />
        <Button
            android:id="@+id/btn0"
            style="@style/LockKey"
            android:text="0" />
        <Button
            android:id="@+id/btnBack"
            style="@style/LockKey"
            android:text="⌫" />
    </GridLayout>
</LinearLayout>
