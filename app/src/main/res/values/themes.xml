<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 亮色 -->
    <style name="Theme.WristChat" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:textColor">@color/text_light</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.AppCompat.Dialog.Alert</item>
        <item name="wristBackground">@color/bg_light</item>
        <item name="wristSurface">@color/surface_light</item>
        <item name="wristText">@color/text_light</item>
        <item name="wristHint">@color/hint_light</item>
        <item name="wristBubbleUser">#D2E5FF</item>
        <item name="wristBubbleAi">#EFF1F4</item>
        <item name="wristDivider">#E0E3E7</item>
    </style>

    <!-- 暗色 -->
    <style name="Theme.WristChat.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.AppCompat.Dialog.Alert</item>
        <item name="wristBackground">@color/bg_dark</item>
        <item name="wristSurface">@color/surface_dark</item>
        <item name="wristText">@color/text_dark</item>
        <item name="wristHint">@color/hint_dark</item>
        <item name="wristBubbleUser">#1E3A5F</item>
        <item name="wristBubbleAi">#1B2228</item>
        <item name="wristDivider">#2A323A</item>
    </style>

    <!-- AMOLED 纯黑 -->
    <style name="Theme.WristChat.Amoled" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_amoled</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.AppCompat.Dialog.Alert</item>
        <item name="wristBackground">@color/bg_amoled</item>
        <item name="wristSurface">@color/surface_amoled</item>
        <item name="wristText">@color/text_dark</item>
        <item name="wristHint">@color/hint_dark</item>
        <item name="wristBubbleUser">#14304F</item>
        <item name="wristBubbleAi">#11161A</item>
        <item name="wristDivider">#1D242A</item>
    </style>

    <!-- 密码键盘按键 -->
    <style name="LockKey" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/wristText</item>
        <item name="android:background">@drawable/bg_key</item>
    </style>

    <!-- 顶栏小图标按钮 -->
    <style name="HeaderIcon" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">?attr/wristText</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
